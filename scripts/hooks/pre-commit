#!/usr/bin/env bash
# Pre-commit guard: secrets and personal data never reach the repo.
#
# Installed per clone by scripts/install-hooks.sh (git config core.hooksPath
# scripts/hooks). Two layers:
#
#   1. gitleaks, when it is on PATH: the default secret rules plus the
#      repo's own rules in .gitleaks.toml (US phone numbers and personal-domain
#      email addresses in docs/, tests/ and client/test/).
#   2. Always: a grep over the STAGED added lines for the same personal-data
#      patterns, plus a refusal of files that must never be committed (.env,
#      signing keys, key.properties, spreadsheet exports in docs/).
#
# Fiction that passes: 555 numbers (use 555-0100..555-0199), toll-free lines,
# example.com / .test / .invalid addresses, and the business lines listed in
# scripts/hooks/pii-allowlist.txt.
#
# A finding blocks the commit. To commit anyway after checking the value is
# not personal data: add it to scripts/hooks/pii-allowlist.txt (and to the
# allowlist in .gitleaks.toml) in the same commit, or, for a one-off,
# `git commit --no-verify` and say why in the commit message.

set -u
root="$(git rev-parse --show-toplevel)" || exit 1
cd "$root" || exit 1

fail=0
red() { printf '\033[31m%s\033[0m\n' "$*" >&2; }

# ── 0. files that are never committed ─────────────────────────────────────
forbidden='(^|/)(\.env(\..+)?|key\.properties|[^/]*\.(jks|keystore|p8|p12|pfx|pem|key|mobileprovision))$|^docs/.*\.(csv|tsv|xlsx|xls)$'
while IFS= read -r -d '' f; do
    case "$f" in
        .env.example|docs/agents/task-labels-canonical-2026-11-19.csv) continue ;;
    esac
    if printf '%s\n' "$f" | grep -Eq "$forbidden"; then
        red "pre-commit: refusing to commit $f (secret, signing key or data export)."
        fail=1
    fi
done < <(git diff --cached --name-only --diff-filter=ACR -z)

# ── 1. gitleaks ────────────────────────────────────────────────────────────
if command -v gitleaks >/dev/null 2>&1; then
    if gitleaks git --help >/dev/null 2>&1; then
        gitleaks git --pre-commit --staged --redact --no-banner --config "$root/.gitleaks.toml" "$root" || fail=1
    else
        gitleaks protect --staged --redact --no-banner --config "$root/.gitleaks.toml" || fail=1
    fi
else
    echo "pre-commit: gitleaks not installed; using the built-in grep only (https://github.com/gitleaks/gitleaks#installing)." >&2
fi

# ── 2. built-in grep over staged added lines ──────────────────────────────
allow_file="$root/scripts/hooks/pii-allowlist.txt"
allowed_digits=''
if [ -f "$allow_file" ]; then
    allowed_digits="$(grep -Eo '^[0-9]{10}' "$allow_file" | paste -sd'|' -)"
fi

phone_re='(\+1[ .-]?)?\(?[2-9][0-9]{2}\)?[ .-][2-9][0-9]{2}[ .-][0-9]{4}|\+1[2-9][0-9]{2}[2-9][0-9]{6}|\([2-9][0-9]{2}\)[2-9][0-9]{2}-[0-9]{4}'
email_re='[A-Za-z0-9._%+-]+@(gmail|googlemail|yahoo|ymail|rocketmail|icloud|me|mac|hotmail|outlook|live|msn|aol|comcast|att|sbcglobal|bellsouth|verizon|cox|optonline|protonmail|proton)\.(co\.uk|com|net|fr|con|me)'
email_ok='(sample|example|test|demo|fake|dummy|placeholder|jane|john|doe)[^@]*@|^(no|nm|n|na|naa|none|nomail|noemail[0-9]*|noemai|nonail|nomaol|noname|notavaliable11|refused?|cxdeclined(email)?|fhfg|ghfg|nora|bob|person)@'
secret_re='-----BEGIN ([A-Z]+ )?PRIVATE KEY-----|AKIA[0-9A-Z]{16}|sk_live_[0-9A-Za-z]{20,}|rk_live_[0-9A-Za-z]{20,}|xox[baprs]-[0-9A-Za-z-]{10,}|ghp_[0-9A-Za-z]{36}|github_pat_[0-9A-Za-z_]{40,}|sk-ant-[0-9A-Za-z_-]{20,}|AC[0-9a-f]{32}'

digits_of() { printf '%s' "$1" | tr -cd '0-9' | sed -E 's/^1([0-9]{10})$/\1/'; }

phone_ok() {
    local d; d="$(digits_of "$1")"
    local a="${d:0:3}" b="${d:3:3}" c="${d:6:4}"
    [ "${#d}" -ne 10 ] && return 0
    [ "$a" = 555 ] || [ "$b" = 555 ] && return 0
    case "$a" in 800|833|844|855|866|877|888) return 0 ;; esac
    case "$c" in 0000|1111|1234) return 0 ;; esac
    printf '%s' "$d" | grep -Eq '^([0-9])\1+$' && return 0
    [ -n "$allowed_digits" ] && printf '%s' "$d" | grep -Eq "^($allowed_digits)$" && return 0
    return 1
}

while IFS= read -r -d '' f; do
    added="$(git diff --cached -U0 --no-color -- "$f" | grep -E '^\+' | grep -Ev '^\+\+\+ ')"
    [ -z "$added" ] && continue

    # Secrets: everywhere.
    if printf '%s\n' "$added" | grep -Eq -- "$secret_re"; then
        if ! printf '%s\n' "$added" | grep -E -- "$secret_re" | grep -Eq 'AC(x{32}|a{32}|b{32}|c{32})|PLACEHOLDER|EXAMPLE|\.\.\.'; then
            red "pre-commit: $f adds what looks like a key or token."
            fail=1
        fi
    fi

    # Personal data: docs and test fixtures, where real rows get pasted.
    case "$f" in
        docs/*|tests/*|client/test/*) ;;
        *) continue ;;
    esac
    while IFS= read -r p; do
        [ -z "$p" ] && continue
        if ! phone_ok "$p"; then
            red "pre-commit: $f adds a phone number ($p). Use a 555-01xx number."
            fail=1
        fi
    done < <(printf '%s\n' "$added" | grep -Eo -- "$phone_re")
    while IFS= read -r e; do
        [ -z "$e" ] && continue
        if ! printf '%s' "$e" | grep -Eiq -- "$email_ok"; then
            red "pre-commit: $f adds a personal email address ($e). Use name@example.com."
            fail=1
        fi
    done < <(printf '%s\n' "$added" | grep -Eio -- "$email_re")
done < <(git diff --cached --name-only --diff-filter=ACMR -z)

if [ "$fail" -ne 0 ]; then
    red "pre-commit: commit blocked. Replace real customer/staff data with fiction (docs/security/repo-pii-inventory-2026-11-25.md)."
    exit 1
fi
exit 0
