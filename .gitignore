# ── secrets: never commit ──────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
*.p12
auth.json
oauth2*.json
*credentials*

# ── dependencies / build ──────────────────────────────
/vendor
/node_modules
/public/build
/public/hot
/public/storage
/storage/*.key
/storage/framework/cache/*
/storage/framework/sessions/*
/storage/framework/views/*
/storage/logs/*
!/storage/**/.gitkeep

# ── local ─────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
*.log
