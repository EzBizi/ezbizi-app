#!/bin/bash
#
# VERSIONED COPY of /var/repos/ezbizi.git/hooks/post-receive on the app box.
#
# The live file is the one that runs; this is here so it is reviewable and a
# rebuilt box is reproducible — the same reason the nginx configs are versioned.
# Editing one without the other is exactly the drift this project already paid
# for once (§17), so change this file, then copy it up:
#
#   scp deploy/post-receive app:/tmp/ && ssh app #     'sudo cp /tmp/post-receive /var/repos/ezbizi.git/hooks/ && sudo chmod +x /var/repos/ezbizi.git/hooks/post-receive'
#
#
# Deploy on push to main (plan §11.2).
#
# Deliberately NOT a bare `git pull` in the live directory: a pull leaves the
# app half-updated while composer runs, and a failed install leaves it broken
# with no way back. This checks out, prepares, and only then swaps — and it
# refuses to swap at all if anything fails.
#
set -uo pipefail

APP=/var/www/ezbizi
RELEASES=/var/www/ezbizi-releases
KEEP=5
BRANCH=main

while read -r _old _new ref; do
  [ "$ref" = "refs/heads/$BRANCH" ] || { echo "  (ignoring $ref)"; continue; }

  STAMP=$(date +%Y%m%d%H%M%S)
  TARGET="$RELEASES/$STAMP"
  mkdir -p "$TARGET"

  echo "→ checking out $BRANCH"
  git --work-tree="$TARGET" --git-dir=/var/repos/ezbizi.git checkout -f "$BRANCH"

  echo "→ carrying over environment + storage"
  # .env NEVER lives in the repo (plan §15 Phase 0). It stays on the box.
  cp "$APP/.env" "$TARGET/.env"
  # Storage holds uploads and logs; it must survive releases.
  rm -rf "$TARGET/storage"
  ln -s "$APP/storage" "$TARGET/storage"

  # The Flutter web build is DERIVED, so it is not in the repo (36 MB, almost
  # all CanvasKit, and a fresh blob every rebuild). It is built locally and
  # uploaded to the shared directory, then symlinked in — exactly like storage.
  # Consequence: a code-only deploy leaves the existing UI in place, which is
  # what you want; shipping a stale UI beats shipping none.
  rm -rf "$TARGET/public/app"
  ln -s "$APP/public-app" "$TARGET/public/app"

  echo "→ composer install"
  if ! (cd "$TARGET" && composer install --no-dev --no-interaction --prefer-dist --optimize-autoloader -q); then
    echo "✗ composer failed — deployment aborted, live app untouched"
    rm -rf "$TARGET"; exit 1
  fi

  echo "→ migrations"
  if ! (cd "$TARGET" && php8.4 artisan migrate --force); then
    echo "✗ migrations failed — deployment aborted, live app untouched"
    rm -rf "$TARGET"; exit 1
  fi

  echo "→ caches"
  (cd "$TARGET" && php8.4 artisan config:cache -q && php8.4 artisan route:cache -q && php8.4 artisan view:cache -q)

  echo "→ health check before going live"
  if ! (cd "$TARGET" && php8.4 artisan about --only=environment >/dev/null 2>&1); then
    echo "✗ app failed to boot — deployment aborted, live app untouched"
    rm -rf "$TARGET"; exit 1
  fi

  echo "→ swapping in"
  # Atomic-ish: point the symlink at the new release. nginx serves through it.
  #
  # This MUST abort on failure. An earlier version let a failed symlink fall
  # through to "deployed" — the push looked successful while the live app was
  # still running the previous release, which is the most misleading outcome
  # a deploy can produce.
  if ! ln -sfn "$TARGET" /var/www/ezbizi-current; then
    echo "✗ could not repoint /var/www/ezbizi-current — deployment aborted"
    rm -rf "$TARGET"; exit 1
  fi
  sudo systemctl reload php8.4-fpm 2>/dev/null || true

  # Tell the queue worker to finish its current job and exit; systemd restarts
  # it on the new release. Without this the worker keeps running code from a
  # release directory that pruning will delete underneath it, and the first
  # symptom is a job failing on a missing file rather than anything about the
  # change that was deployed.
  echo "-> asking the queue worker to pick up the new release"
  (cd "$TARGET" && php8.4 artisan queue:restart -q) || true

  echo "→ pruning old releases (keeping $KEEP)"
  ls -1dt "$RELEASES"/*/ 2>/dev/null | tail -n +$((KEEP+1)) | xargs -r rm -rf

  echo "✓ deployed $STAMP"
done
