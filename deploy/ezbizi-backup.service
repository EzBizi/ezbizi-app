# Nightly backup and restore check (plan §18 Phase 0 item 5).
#
# Both scripts in one unit, in order, because a backup whose restore is never
# checked is the thing this is fixing. Splitting them into two timers would let
# the verification quietly stop running while the backup carried on looking
# healthy.
#
# Runs as root: mysqldump needs socket auth, the archives include /etc, and the
# ssh key for the off-site copy is root-only.
#
# Install:
#   sudo cp deploy/backup.sh        /usr/local/bin/ezbizi-backup.sh
#   sudo cp deploy/restore-check.sh /usr/local/bin/ezbizi-restore-check.sh
#   sudo chmod 755 /usr/local/bin/ezbizi-backup.sh /usr/local/bin/ezbizi-restore-check.sh
#   sudo cp deploy/ezbizi-backup.* /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now ezbizi-backup.timer

[Unit]
Description=EzBizi backup and verified restore
After=network-online.target mysql.service

[Service]
Type=oneshot

# The second script runs even if the first reports failures: a partial backup
# still deserves to be checked, and the check is what says which parts are
# usable. `-` prefixes mean systemd does not abandon the unit on a non-zero exit
# — the verdict is carried in backup-status.json, which the app reads.
ExecStart=-/usr/local/bin/ezbizi-backup.sh
ExecStart=-/usr/local/bin/ezbizi-restore-check.sh

# The restore check's 100-byte default rejects monitoring screenshot paths
# (126-157 bytes) that the backup writes as plain USTAR. 255 is USTAR's own cap.
Environment=EZBIZI_PRIVATE_MAX_PATH_BYTES=255

# The restore check refuses a private-file archive over 64 GiB by default; the
# full was 40.7 GB on 11-19, growing ~4.6 GB a day, so it would have gone red
# within a week. 256 GiB, reviewed when the incremental backups land.
Environment=EZBIZI_PRIVATE_MAX_ENCRYPTED_BYTES=274877906944

# The ceiling must cover backup AND restore check. 3600 s killed the restore
# check two nights running (11-18, 11-19) once private files grew from 8.6 GB
# (11-12) to 40.7 GB (11-19): the backup alone now takes ~56 min, so the check
# was cut off and backup-status.json went red. 6 h leaves room for growth.
TimeoutStartSec=21600

# NOT hardened the way the scheduler unit is: this deliberately reads /etc,
# /var/repos and /root, and writes to another host. ProtectSystem here would
# break exactly the parts that make it a backup.
