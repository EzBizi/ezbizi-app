# Starts schedule:run on every third minute, beginning at minute 1; with its
# two siblings every minute is evaluated even when a run takes over a minute.
# See ezbizi-scheduler@.service for why there are three.
#
# Persistent=false: a missed minute is skipped rather than caught up. Catching
# up would fire a minute's worth of automation deliveries at once after a reboot,
# and everything scheduled here is idempotent-by-sweep anyway.

[Unit]
Description=Run EzBizi scheduled tasks, slot 1 (minutes 1, 4, 7, ...)

[Timer]
OnCalendar=*:1/3
AccuracySec=1s
Persistent=false
Unit=ezbizi-scheduler@1.service

[Install]
WantedBy=timers.target
