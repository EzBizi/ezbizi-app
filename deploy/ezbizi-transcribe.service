# Transcribes recorded Local Services calls with Whisper, on this box.
#
# Its own unit, not a line in routes/console.php: a transcription run takes
# minutes, and schedule:run runs a minute's commands one after another, so it
# would hold the every-minute lead sync behind it (see the scheduler unit).
# Lowest CPU priority and at most four cores: the box has sixteen and uses about
# two, and the app must never wait for a transcript.
#
# Install (once; deploy.sh refreshes it after that):
#   sudo cp deploy/ezbizi-transcribe.* /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now ezbizi-transcribe.timer

[Unit]
Description=EzBizi call transcription
After=network.target mysql.service

[Service]
Type=oneshot
User=www-data
Group=www-data
WorkingDirectory=/var/www/ezbizi-current
ExecStart=/usr/bin/php8.4 /var/www/ezbizi-current/artisan ezbizi:transcribe-lead-calls --minutes=4
# Then the Experimental call report's calls - after Leads, never beside it:
# both run Whisper on the same four cores.
ExecStart=/usr/bin/php8.4 /var/www/ezbizi-current/artisan ezbizi:transcribe-report-calls --minutes=3
# Then the AI labels on what was just transcribed (off unless REPORT_CALL_TAGGING).
ExecStart=/usr/bin/php8.4 /var/www/ezbizi-current/artisan ezbizi:label-report-calls --minutes=2
# Then each call divided by speaker, four at a time, for coaching (Reports, 2026-10-13).
# 4+3+2+3 minutes plus one batch running over stays inside TimeoutStartSec.
ExecStart=/usr/bin/php8.4 /var/www/ezbizi-current/artisan ezbizi:label-report-calls --split-only --minutes=3
Nice=19
CPUQuota=400%
TimeoutStartSec=900
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
