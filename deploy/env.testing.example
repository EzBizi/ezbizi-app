# .env.testing — belongs on the box at /var/www/ezbizi/.env.testing
#
# WHY THIS FILE EXISTS
#
# `php artisan --env=testing <anything>` looks for `.env.testing`. If it is not
# there, Laravel falls back to `.env` WITHOUT SAYING SO — and `.env` in that
# directory is the production one, because the sandbox needs the real app key.
#
# On 2026-08-06 that turned `db:wipe --env=testing --force` into a wipe of the
# live database. The flag read as a safety measure and was the opposite.
#
# So: make `--env=testing` mean what it says.
#
# Install:
#   scp deploy/env.testing.example app:/tmp/
#   ssh app 'sudo cp /tmp/env.testing.example /var/www/ezbizi/.env.testing && \
#            sudo chown ubuntu:www-data /var/www/ezbizi/.env.testing'
#
# Then copy APP_KEY across from .env — the app will not boot without it.

APP_ENV=testing
APP_DEBUG=true
APP_KEY=

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ezbizi_testing
DB_USERNAME=ezbizi
DB_PASSWORD=

CACHE_STORE=array
QUEUE_CONNECTION=sync
SESSION_DRIVER=array
MAIL_MAILER=array
