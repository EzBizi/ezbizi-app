# The leads lane of Laravel's scheduler (see the TWO LANES note at the end of
# routes/console.php): only `ezbizi:sync-leads --messages`, every minute, so a
# Local Services text reaches Leads without waiting behind the slow lane's
# Workiz and Monday passes (Jose, 2026-11-23: texts ~4 minutes late).
#
# Install, then turn the lane on (the order matters: on before the timer runs
# would leave LS messages read by no lane):
#   sudo cp deploy/ezbizi-scheduler-leads.service deploy/ezbizi-scheduler-leads.timer /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now ezbizi-scheduler-leads.timer
#   set EZBIZI_LEADS_LANE=on in /var/www/ezbizi/.env, then config:cache
# Check: journalctl -u ezbizi-scheduler-leads.service --since -5min

[Unit]
Description=EzBizi scheduled tasks (leads lane: Local Services messages)
After=network.target mysql.service
OnFailure=ezbizi-scheduler-failed@%N.service

[Service]
Type=oneshot
User=www-data
Group=www-data
WorkingDirectory=/var/www/ezbizi-current
Environment=EZBIZI_SCHEDULE_LANE=leads
ExecStart=/usr/bin/php8.4 /var/www/ezbizi-current/artisan schedule:run
TimeoutStartSec=300

PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
