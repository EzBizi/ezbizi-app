<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
      EzBizi is a client for an API and does nothing at all without the network.

      Flutter's template declares INTERNET in src/debug and src/profile only.
      Release builds merge src/main, so a release AAB built from the template
      ships with no permissions and every request fails — while debug and
      profile builds work perfectly, which is what makes it so easy to miss.
      Caught here on the first Android build, before any tester saw it.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!--
      Notifications, and the reason this is declared rather than left to the
      plugin: Android 13 made POST_NOTIFICATIONS a runtime permission, and a
      runtime permission that is not in the manifest cannot be requested — the
      request returns "denied" immediately, without ever showing a prompt.

      The failure looks exactly like a person having said no. Nothing throws,
      nothing logs, the app carries on and the handset is simply silent, on the
      one OS version that covers most of the phones in use. Below 13 the
      permission is granted at install and this line changes nothing.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!--
      Field (docs/superpowers/specs/2026-09-25-field-module-design.md): GPS for
      people whose role is tracked. NOT ACCESS_BACKGROUND_LOCATION, on purpose:
      the stream always starts while the app is open and keeps running as a
      foreground service with a visible notification, which needs only
      "while using the app". Play still asks for a FOREGROUND_SERVICE_LOCATION
      declaration in the console.
    -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <!--
      Download on a how-to video (Jose, 2026-10-14) saves it to the gallery
      through `gal`. Android 10 and later need no permission for that; 8 and 9
      (minSdk is 26) need this one, and only up to 29.
    -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29"/>
    <application
        android:label="EzBizi"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <!-- The only path an incoming Twilio call has into this app.

             twilio_voice ships VoiceFirebaseMessagingService but does NOT
             declare it in its own manifest, and nothing else did either:
             measured on the shipped 0.0.0183 artefact, the merged manifest
             contained 0 references to it while correctly containing
             TVConnectionService from the same library, so the query worked and
             the absence was real.

             Without this, MESSAGING_EVENT resolves only to the Firebase SDK’s
             own fallback service, which knows nothing about Twilio. So
             registration succeeds, Twilio sends the push, FCM delivers it, and
             the handset never rings - three green steps and a dead end. Its
             onNewToken is also the plugin’s token-rotation path, which was dead
             for the same reason rather than merely unbuilt.

             The firebase_messaging Dart plugin would normally contribute this
             declaration. We deliberately do not use it (see MainActivity.kt),
             so it has to be here. -->
        <service
            android:name="com.twilio.twilio_voice.fcm.VoiceFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Which channel FCM uses when a payload names none.

             The server names `ezbizi_notifications` explicitly, so this is the
             backstop for anything that does not - and for older senders. It is
             only half the job: this says WHICH channel, and MainActivity.kt
             makes sure that channel EXISTS. Without the second half FCM falls
             back to fcm_fallback_notification_channel exactly as if this line
             were absent, which is how it is possible to "fix" this and see no
             change at all. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="ezbizi_notifications" />

        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <!-- url_launcher: sign-in pages open in the person's browser. -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
