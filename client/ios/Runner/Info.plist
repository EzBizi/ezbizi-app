<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<!-- Required because twilio_voice calls AVAudioSession/requestRecordPermission
	     for in-app calling. Apple rejects the upload without it (ITMS-90683)
	     whether or not the API is ever reached, and the string is shown to the
	     person at the moment iOS asks - so it names the feature and gives the
	     example Apple asks for, rather than saying "for audio". -->
	<!-- Export compliance, answered once here instead of once per upload.
	     Without this key App Store Connect marks every build Missing
	     Compliance and asks the same question by hand before the build can
	     go anywhere, including TestFlight.

	     false means "uses no NON-EXEMPT encryption", not "uses none". EzBizi
	     talks HTTPS to its own API and Twilio's calling SDK negotiates TLS
	     and SRTP - all of it standard, published algorithms through the
	     platform's own stack, which is exactly what the exemption covers.

	     This stops being true the day EzBizi ships its OWN cryptography:
	     a bundled cipher, a proprietary key exchange, end-to-end encrypted
	     messaging with keys the server never sees. Any of those and this key
	     has to become true and the annual self-classification report starts
	     applying. Using a library that speaks TLS is not that.
	-->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- Field: GPS for people whose role is tracked, while their organization's
	     tracking window is open (clocked in, scheduled hours, or always), and
	     for SOS. `location` in UIBackgroundModes keeps it running with the blue
	     indicator showing; "Always" is never required, since sharing always
	     starts while the app is open. -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Your organization uses your location while you are working, for your safety, to see when you arrive at a job, and to suggest the fastest route between your jobs. It is also sent when you press SOS.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Your organization uses your location while you are working, for your safety, to see when you arrive at a job, and to suggest the fastest route between your jobs. It is also sent when you press SOS.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>EzBizi saves a how-to video to your Photos when you tap Download on it. It only adds that video; it never reads your photos.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>EzBizi uses the microphone so you can speak on phone calls made and received in the app, and to record a job visit for your safety when you choose to start a recording. It is used only during a call or a recording you started.</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>EzBizi</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>EzBizi</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<!-- Incoming calls arrive as a VoIP push, and iOS will not deliver one to
	     an app that has not declared it can be woken for a call. Without `voip`
	     the device registers with Twilio, outgoing calls work, and an incoming
	     call simply never arrives — which is exactly what Jose saw on TestFlight
	     on 2026-09-09. `audio` keeps the call alive once it is answered and the
	     app goes to the background, which is most of a call. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>voip</string>
		<string>audio</string>
		<string>location</string>
	</array>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
