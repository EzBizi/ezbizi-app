<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- The whole app is HTTP calls to app.ezbizi.com. A sandboxed build with no
	     network.client entitlement launches, draws the sign-in screen, and every
	     request fails - not a permission prompt, a silent refusal. -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- Communication takes calls in the app. Without audio-input the Twilio
	     device registers and every call is one-way. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<!-- Chat video calls (Twilio Video in a web view). -->
	<key>com.apple.security.device.camera</key>
	<true/>
</dict>
</plist>
