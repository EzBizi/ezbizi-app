<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIconFile</key>
	<string></string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<!-- Export compliance, answered once here instead of once per upload.
	     Without this key App Store Connect marks every build Missing
	     Compliance and asks the same question by hand before the build can
	     go anywhere, including TestFlight.

	     false means "uses no NON-EXEMPT encryption", not "uses none". EzBizi
	     talks HTTPS to its own API and Twilio's calling SDK negotiates TLS
	     and SRTP - all of it standard, published algorithms through the
	     platform's own stack, which is exactly what the exemption covers.

	     This stops being true the day EzBizi ships its OWN cryptography:
	     a bundled cipher, a proprietary key exchange, end-to-end encrypted
	     messaging with keys the server never sees. Any of those and this key
	     has to become true and the annual self-classification report starts
	     applying. Using a library that speaks TLS is not that.
	-->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.business</string>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<key>NSHumanReadableCopyright</key>
	<string>$(PRODUCT_COPYRIGHT)</string>
	<!-- Field: geolocator links CoreLocation into the Mac build, and Apple's
	     upload scan (ITMS-90683) flags a linked location API with no purpose
	     string. The Mac app never asks for location (tracking and SOS positions
	     are phone-only, field_tracker.dart onPhone), so this is never shown. -->
	<key>NSLocationUsageDescription</key>
	<string>Location sharing is available in the EzBizi iPhone and Android apps. The Mac app does not use your location.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>EzBizi needs the microphone so you can speak during phone calls made and received in the app, such as calling a customer back about a job, and during voice and video calls with colleagues in Chat. It is used only while you are on a call.</string>
	<key>NSCameraUsageDescription</key>
	<string>EzBizi uses the camera only during a video call with colleagues in Chat, after you start or answer one.</string>
	<key>NSMainNibFile</key>
	<string>MainMenu</string>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
</dict>
</plist>
