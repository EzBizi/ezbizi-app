APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

# Off until mail can verify an address. Tests turn this on in phpunit.xml.
EZBIZI_SIGNUP_ENABLED=false

# Comma-separated. Localhost any-port is allowed by pattern in config/cors.php.
CORS_ALLOWED_ORIGINS=https://app.ezbizi.com,https://dev.ezbizi.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Shared inboxes on Google (the Email module).
#
# Both come from an OAuth 2.0 "Web application" client in a Google Cloud
# project with the Gmail API enabled. Until they are set, the Email module says
# so on screen and refuses to start a sign-in — it does not fail halfway
# through one.
#
# The redirect URI must be registered on that client CHARACTER FOR CHARACTER.
# It defaults to this application's own callback on APP_URL, so the third
# variable is only needed when the public origin differs from APP_URL:
#     https://app.ezbizi.com/api/v1/email/google/callback
GOOGLE_MAIL_CLIENT_ID=
GOOGLE_MAIL_CLIENT_SECRET=
GOOGLE_MAIL_REDIRECT_URI=

# Service account for Google Workspace domain-wide delegation (optional).
# Lets a company connect its Workspace once, then pick shared inboxes from
# the Directory. The numeric client ID is what a Workspace admin pastes into
# Google Admin → Security → Domain-wide delegation. See MAIL-SETUP.md.
GOOGLE_MAIL_WORKSPACE_CLIENT_EMAIL=
GOOGLE_MAIL_WORKSPACE_PRIVATE_KEY=
GOOGLE_MAIL_WORKSPACE_CLIENT_ID=

# Google Workspace Marketplace listing (optional). When set, Connect Workspace
# offers Admin install — the Super Admin clicks Allow once. Public listing
# needs Google's review. See MAIL-SETUP.md.
GOOGLE_MAIL_MARKETPLACE_URL=

# Microsoft 365 shared inboxes (optional). Azure app registration, Mail.Read
# Mail.Send offline_access. Redirect must match character for character:
#     https://app.ezbizi.com/api/v1/email/microsoft/callback
MICROSOFT_MAIL_CLIENT_ID=
MICROSOFT_MAIL_CLIENT_SECRET=
MICROSOFT_MAIL_REDIRECT_URI=

# Pinterest (optional). Trial app at developers.pinterest.com. Redirect must
# match character for character:
#     https://app.ezbizi.com/api/v1/social/pinterest/callback
# Monday (Connect Monday, and the signature on its webhooks): the "EzBizi" app
# on Monday's Developer Center. Register APP_URL/api/v1/social/monday/callback
# as its redirect URL. Read only: EzBizi never writes to Monday.
MONDAY_CLIENT_ID=
MONDAY_CLIENT_SECRET=
MONDAY_SIGNING_SECRET=
MONDAY_REDIRECT_URI=
# QuickBooks Online (Connect QuickBooks, Financials › Markets): the "EzBizi" app
# at developer.intuit.com, scope com.intuit.quickbooks.accounting. Register
# APP_URL/api/v1/social/quickbooks/callback as its redirect URI. Read only.
# QUICKBOOKS_ENVIRONMENT=sandbox uses the Development keys and sandbox companies.
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_ENVIRONMENT=production
QUICKBOOKS_REDIRECT_URI=

PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
PINTEREST_REDIRECT_URI=

# Meta (Facebook Pages, Instagram professional, Threads). One app, three
# redirect URIs, character for character:
#     https://app.ezbizi.com/api/v1/social/facebook/callback
#     https://app.ezbizi.com/api/v1/social/instagram/callback
#     https://app.ezbizi.com/api/v1/social/threads/callback
# No ads, no Messenger.
META_APP_ID=
META_APP_SECRET=

# LinkedIn. Callback:
#     https://app.ezbizi.com/api/v1/social/linkedin/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# TikTok Login Kit + Content Posting. client_key, not client_id. Callback:
#     https://app.ezbizi.com/api/v1/social/tiktok/callback
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Has THIS installation's TikTok app passed their audit? Leave false until it
# has. Direct Post requires the audit and refuses without it in a sentence that
# blames the video ("Please review our integration guidelines"), so until then
# posts go to the creator's TikTok drafts, which works from day one. Flip to
# true the day the audit clears — no code change, no release.
TIKTOK_DIRECT_POST=false

# YouTube Data API. Separate Google OAuth client from Gmail. Callback:
#     https://app.ezbizi.com/api/v1/social/youtube/callback
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# X API v2 OAuth 2.0 (PKCE). Callback:
#     https://app.ezbizi.com/api/v1/social/x/callback
X_CLIENT_ID=
X_CLIENT_SECRET=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# The other box the app watchdog asks. No default: www.ezbizi.com is THIS box.
# Production: https://panel.triplexhost.net
EZBIZI_PEER_URL=

# Telegram staff Tech Assistant bot (docs/TELEGRAM-BOT.md)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ORG_ID=

# Payments (Stripe Connect, Standard). Platform secret key from the EzBizi
# Stripe account; the Connect endpoint's signing secret (whsec_).
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=
STRIPE_CONNECT_DASHBOARD=full
STRIPE_APPLICATION_FEE_PERCENT=0
